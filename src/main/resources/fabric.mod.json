{
  "schemaVersion": 1,
  "id": "cicadas-renderer",
  "version": "${version}",
  "name": "cicadas-renderer",
  "description": "A render library for minecraft",
  "authors": ["cicadasmixtape"],
  "contact": {},
  "license": "All-Rights-Reserved",
  "icon": "assets/cicadasrenderer/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "cicadas.mixtape.renderer.CicadasRenderer"
      }
    ]
  },
  "mixins": [
    "cicadas-renderer.mixins.json"
  ],
  "depends": {
    "minecraft": "${minecraft_version}",
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "fabric-language-kotlin": ">=${kotlin_language_version}"
  }
}